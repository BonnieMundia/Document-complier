# AcadCompiler environment variables
# Copy to .env and fill in real values

# Backend
ENGINE_VERSION=0.1.0
CSL_VERSION=1.0
MAX_UPLOAD_MB=20
JWT_SECRET=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379/0

# Supabase (optional — app works without it using in-memory store)
SUPABASE_URL=
SUPABASE_KEY=

# Anthropic (optional — LLM advisory layer, disabled by default)
ANTHROPIC_API_KEY=
LLM_ENABLED=false
